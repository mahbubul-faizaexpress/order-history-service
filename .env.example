# Copy to .env and adjust if needed.

PORT=3000

# Host port the Postgres container binds to (compose reads this).
# Change it if 5432 is already in use locally, and update the URLs below to match.
POSTGRES_HOST_PORT=5432

# Primary database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orders

# Database used by `npm test` (created/reset by the test harness)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/orders_test

# HS256 secret used to verify incoming Bearer tokens.
# In a real system the auth service owns this; here we assume tokens are pre-issued.
JWT_SECRET=dev-only-change-me

# Statement timeout applied to every pooled connection (milliseconds)
DB_STATEMENT_TIMEOUT_MS=5000

# pg pool size
DB_POOL_MAX=10

LOG_LEVEL=info
